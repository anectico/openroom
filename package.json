{
	"name": "openroom",
	"version": "0.0.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE.md",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check . && npm run check && node scripts/check-no-comments.ts",
		"format": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"cli:generate": "node scripts/generate-cli.ts",
		"cli:pack": "npm run cli:generate && mkdir -p artifacts/release && npm pack ./cli --pack-destination artifacts/release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.71.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/archiver": "^8.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1158.0",
		"@aws-sdk/lib-storage": "3.1158.0",
		"@aws-sdk/s3-request-presigner": "3.1166.0",
		"@better-auth/api-key": "^1.7.18",
		"@cantoo/pdf-lib": "^2.11.1",
		"@modelcontextprotocol/server": "2.4.0",
		"archiver": "^8.0.0",
		"better-auth": "^1.7.20",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"file-type": "^22.3.0",
		"flydrive": "^2.2.0",
		"markdown-it": "^14.3.3",
		"nodemailer": "^10.2.1",
		"pdfjs-dist": "^6.4.299",
		"resend": "^6.34.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"better-sqlite3@13.0.3": false,
		"fsevents@2.3.3": true
	},
	"overrides": {
		"readdir-glob": {
			"minimatch": "11.0.8"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
